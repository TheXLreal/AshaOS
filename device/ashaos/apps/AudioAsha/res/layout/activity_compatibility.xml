<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/compatibility_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ashaos_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/compatibility_title"
            android:textColor="@color/ashaos_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/refresh_compatibility"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="@string/refresh_diagnostics"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/compatibility_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/ashaos_text_primary"
            android:textIsSelectable="true"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/compatibility_guidance"
            android:textColor="@color/ashaos_text_secondary"
            android:textIsSelectable="true"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
