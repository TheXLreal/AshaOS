<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ashaos_background"
    android:clipToPadding="false"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/ashaos_title" android:textColor="@color/ashaos_primary"
                    android:textSize="30sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/app_name" android:textColor="@color/ashaos_text_secondary"
                    android:textSize="15sp" />
            </LinearLayout>
            <Button android:id="@+id/open_appearance" android:layout_width="wrap_content"
                android:layout_height="48dp" android:text="@string/appearance"
                android:textAllCaps="false" />
        </LinearLayout>
        <TextView android:id="@+id/session_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="20dp"
            android:background="@drawable/ashaos_card" android:padding="18dp"
            android:text="@string/session_stopped" android:textColor="@color/ashaos_text_primary"
            android:textSize="16sp" android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/ashaos_card"
            android:orientation="vertical"
            android:padding="18dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/connection_heading" android:textColor="@color/ashaos_text_primary"
                android:textSize="20sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/connection_mode"
                    android:textColor="@color/ashaos_text_primary" android:textSize="16sp" />
                <Button android:id="@+id/help_connection" android:layout_width="48dp"
                    android:layout_height="48dp" android:contentDescription="@string/help_connection_description"
                    android:text="?" android:textAllCaps="false" />
            </LinearLayout>
            <Spinner android:id="@+id/connection_mode" android:layout_width="match_parent"
                android:layout_height="52dp" android:entries="@array/connection_mode_values" />
            <TextView android:id="@+id/connection_endpoint" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp" android:text="@string/connection_unavailable"
                android:textColor="@color/ashaos_text_secondary" android:textIsSelectable="true"
                android:textSize="14sp" />
            <Button android:id="@+id/copy_connection_endpoint" android:layout_width="wrap_content"
                android:layout_height="48dp" android:layout_marginTop="8dp"
                android:text="@string/copy_connection_endpoint" android:textAllCaps="false" />
            <LinearLayout android:id="@+id/udp_controls" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical">
                <EditText android:id="@+id/udp_port" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp"
                    android:hint="@string/udp_port" android:inputType="number"
                    android:maxLength="5" android:singleLine="true" android:text="48100" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="@string/jitter_buffer"
                        android:textColor="@color/ashaos_text_primary" />
                    <Button android:id="@+id/help_jitter" android:layout_width="48dp"
                        android:layout_height="48dp" android:contentDescription="@string/help_jitter_description"
                        android:text="?" android:textAllCaps="false" />
                </LinearLayout>
                <Spinner android:id="@+id/jitter_buffer" android:layout_width="match_parent"
                    android:layout_height="48dp" android:entries="@array/jitter_buffer_values" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="@string/output_device"
                android:textColor="@color/ashaos_text_primary" />
            <Spinner android:id="@+id/output_device" android:layout_width="match_parent"
                android:layout_height="48dp" />
            <Switch android:id="@+id/start_after_boot" android:layout_width="match_parent"
                android:layout_height="48dp" android:layout_marginTop="8dp"
                android:text="@string/start_after_boot" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:orientation="horizontal">
                <Button android:id="@+id/start_streaming" android:layout_width="0dp"
                    android:layout_height="52dp" android:layout_weight="1"
                    android:text="@string/start_streaming" android:textAllCaps="false" />
                <Button android:id="@+id/stop_streaming" android:layout_width="0dp"
                    android:layout_height="52dp" android:layout_marginStart="8dp"
                    android:layout_weight="1" android:enabled="false"
                    android:text="@string/stop_streaming" android:textAllCaps="false" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:background="@drawable/ashaos_card"
            android:orientation="vertical" android:padding="18dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/setup_heading" android:textColor="@color/ashaos_text_primary"
                android:textSize="20sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/setup_explanation"
                android:textColor="@color/ashaos_text_secondary" />
            <Button android:id="@+id/open_tether_settings" android:layout_width="match_parent"
                android:layout_height="48dp" android:layout_marginTop="8dp"
                android:text="@string/open_tether_settings" android:textAllCaps="false" />
            <Button android:id="@+id/open_developer_settings" android:layout_width="match_parent"
                android:layout_height="48dp" android:text="@string/open_developer_settings"
                android:textAllCaps="false" />
            <Button android:id="@+id/open_hearing_settings" android:layout_width="match_parent"
                android:layout_height="48dp" android:text="@string/open_hearing_settings"
                android:textAllCaps="false" />
            <Button android:id="@+id/open_bluetooth_settings" android:layout_width="match_parent"
                android:layout_height="48dp" android:text="@string/open_bluetooth_settings"
                android:textAllCaps="false" />
            <Button android:id="@+id/open_wifi_settings" android:layout_width="match_parent"
                android:layout_height="48dp" android:text="@string/open_wifi_settings"
                android:textAllCaps="false" />
            <Button android:id="@+id/open_app_settings" android:layout_width="match_parent"
                android:layout_height="48dp" android:text="@string/open_app_settings"
                android:textAllCaps="false" />
        </LinearLayout>
        <Button android:id="@+id/toggle_diagnostics" android:layout_width="match_parent"
            android:layout_height="48dp" android:layout_marginTop="16dp"
            android:text="@string/show_diagnostics" android:textAllCaps="false" />
        <LinearLayout android:id="@+id/diagnostics_panel" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:background="@drawable/ashaos_card" android:orientation="vertical"
            android:padding="18dp" android:visibility="gone">
            <Button android:id="@+id/check_audio_devices" android:layout_width="match_parent"
                android:layout_height="48dp" android:text="@string/refresh_audio_devices"
                android:textAllCaps="false" />
            <Button android:id="@+id/compatibility_diagnostics" android:layout_width="match_parent"
                android:layout_height="48dp" android:text="@string/compatibility_diagnostics"
                android:textAllCaps="false" />
            <TextView android:id="@+id/audio_devices" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:fontFamily="monospace" android:lineSpacingExtra="2dp"
                android:text="@string/diagnostics_waiting"
                android:textColor="@color/ashaos_text_primary"
                android:textIsSelectable="true" android:textSize="13sp" />
            <TextView android:id="@+id/android_version" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="20dp"
                android:textColor="@color/ashaos_text_secondary" android:textSize="13sp" />
            <TextView android:id="@+id/device_product" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:textColor="@color/ashaos_text_secondary" android:textSize="13sp" />
            <TextView android:id="@+id/application_version" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:textColor="@color/ashaos_text_secondary" android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
